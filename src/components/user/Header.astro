---
// Никакого JS не требуется, это чистый HTML-компонент
---

<header class="w-full">
  <nav class="mx-auto flex w-full items-center justify-between text-white">
    {/* Логотип */}
    <div class="h-9 w-45">
      <img src="/tanitim_logo.png" alt="Logo" class="h-full w-full object-cover" />
    </div>

    {/* Навигационные ссылки */}
    <div class="hidden items-center gap-8 md:flex text-sm font-medium">
      <a href="#about" class="transition-opacity hover:opacity-75">
        Haqqımızda
      </a>
      <a href="#services" class="transition-opacity hover:opacity-75">
        Xidmətlər
      </a>
      <a href="#portfolio" class="transition-opacity hover:opacity-75">
        Portfolio
      </a>
      <a href="#contact" class="transition-opacity hover:opacity-75">
        Əlaqə
      </a>
    </div>

    {/* Кнопка действия */}
    <a
      href="#contact"
      class="bg-[#F0692A] px-5 py-2.5 text-sm font-bold text-white transition-transform hover:scale-105 active:scale-95 select-none"
    >
      Sifariş et
    </a>
  </nav>
</header>
