---


<section class="relative w-full py-16 text-white overflow-hidden">
  <!-- 1. Фоновая картинка (без -z-10) -->
  <img
    src="/bg.jpg"
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
  />
  
  <!-- 2. Темный оверлей поверх картинки -->
  <div class="absolute inset-0 bg-black/40"></div>

  <!-- 3. Контент (z-10 гарантирует, что текст будет ПОВЕРХ картинки и оверлея) -->
  <div class="relative z-10 mx-auto max-w-[1180px] px-4">
    <h2 class="text-4xl font-bold">
      Baner tam eninə ekran!
    </h2>
  </div>
</section>
