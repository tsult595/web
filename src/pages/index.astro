---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/user/mainPage/Hero.astro';
import { IndexPageClient } from '../pages/user/IndexPageClient';
---

<Layout title="Tanitim.az — Главная">
  <div
    id="main-content"
    style="position: relative; right: -20px; transition: right 0.8s cubic-bezier(0.16, 1, 0.3, 1);"
  >
    <IndexPageClient client:load>
      <main>
        <Hero />
      </main>
    </IndexPageClient>
  </div>

  <script>
    window.addEventListener('start-page-enter', () => {
      const mainContent = document.getElementById('main-content');
      if (mainContent) {
        mainContent.style.right = '0';
      }
    });
  </script>
</Layout>